# ---------------------------------------------------------------------------
# agentic-rag-finance runtime configuration.
# Copy to `.env` and edit. Every value here mirrors a default in
# src/agentic_rag/config.py; environment variables take precedence at runtime.
# ---------------------------------------------------------------------------

# ---- LLM backend ----------------------------------------------------------
# ollama | vllm | openai   (vllm/openai both speak the OpenAI-compatible API)
LLM_BACKEND=ollama
# Ollama model tag. Default is the small model present on this box for fast smoke
# tests; switch to e.g. qwen2.5:7b / qwen3:30b in production.
LOCAL_LLM=qwen2.5:0.5b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_PREDICT=512
OLLAMA_JSON_NUM_PREDICT=256
# Used when LLM_BACKEND=vllm|openai
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENAI_API_KEY=EMPTY
LLM_TEMPERATURE=0.0
REQUEST_TIMEOUT=120

# ---- Embeddings (three-tier fallback: bge -> nomic -> hashing) -------------
EMBEDDINGS_BACKEND=bge
BGE_MODEL_NAME=BAAI/bge-base-zh-v1.5
EMBED_DEVICE=auto
EMBED_BATCH_SIZE=32
HASHING_FEATURES=2048

# ---- Retrieval (P2 hybrid) ------------------------------------------------
RETRIEVAL_TOPK=5
DENSE_TOPK=20
BM25_TOPK=20
RRF_K=60
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOPK=5

# ---- Graph (self-correction loop) -----------------------------------------
MAX_RETRIES=3
RECURSION_LIMIT=50
ENABLE_WEB_SEARCH=false

# ---- Demo / benchmark -----------------------------------------------------
EXAMPLES_TO_RUN=3

# ---- Optional web search --------------------------------------------------
# TAVILY_API_KEY=<insert your API key here>
